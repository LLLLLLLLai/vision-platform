# Vision Platform production MySQL 8 example
# Copy these values into .env and replace every CHANGE_ME placeholder.
# Do not commit the real .env file or database password.
APP_ENV=production
APP_DEBUG=false
DATABASE_URL=mysql+pymysql://vision_platform:CHANGE_ME@127.0.0.1:3306/vision_platform?charset=utf8mb4
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Keep application paths and model URLs in the main .env file.
