# 160 GPU 推理服务器：复制为 .env 后修改，禁止提交真实密钥。
YOLO_INFERENCE_PORT=8091
YOLO_INFERENCE_API_KEY=replace-with-a-long-random-secret
# 例如 /srv/vision-models，要求结构与应用服务器的 VISION_MODEL_STORAGE_ROOT 一致。
MODEL_STORAGE_HOST_PATH=/srv/vision-models
INFERENCE_MAX_UPLOAD_MB=50
# 多卡服务器可填 0、1；单卡保留 all。
YOLO_VISIBLE_DEVICES=all
