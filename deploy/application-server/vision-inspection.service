[Unit]
Description=Vision Platform Inspection Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vision
Group=vision
WorkingDirectory=/opt/vision-platform
EnvironmentFile=/etc/vision-platform/inspection.env
ExecStart=/opt/vision-platform/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 9011
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
