# 应用服务器：生产检测服务（/api/detect 与已发布场景 API）
APP_ROLE=INSPECTION
APP_HOST=0.0.0.0
APP_PORT=9011
DATABASE_URL=mysql+pymysql://<user>:<password>@<mysql-host>:3306/vision_platform?charset=utf8mb4
AUTOMATION_WORKER_ENABLED=false

# 生产实例本身不加载 YOLO；所有训练模型均由 160 推理服务执行。
VISION_MODEL_STORAGE_ROOT=/mnt/vision-models
YOLO_INFERENCE_MODE=REMOTE
YOLO_INFERENCE_BASE_URL=http://<160服务器IP>:8091
YOLO_INFERENCE_API_KEY=<same-as-160>
YOLO_INFERENCE_TIMEOUT_SECONDS=45
PRODUCTION_IMAGE_PARALLELISM=2
PRODUCTION_ROI_PARALLELISM=3
PRODUCTION_VLM_PARALLELISM=3

# SMB、SCENE_API_KEY、VLM_SECRET_KEY 等生产机密只填写在本机 .env / systemd EnvironmentFile。
