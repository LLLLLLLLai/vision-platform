APP_NAME=Vision Platform
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=9010
# 本地功能验证可继续使用 SQLite；生产环境请复制 config/mysql.env.example 的数据库配置。
DATABASE_URL=sqlite:///./data/vision_platform.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
EMBEDDING_STORAGE_ROOT=./embeddings
# Harness 风格的运行档案：当前仅保留本地 OpenCV 规则和图像对齐能力。
HARNESS_PROFILE=production
HARNESS_CONFIG_PATH=config/harness.json
# 需要暂时禁用本地规则插件时以英文逗号分隔，例如：opencv_rules
HARNESS_DISABLED_PLUGINS=
# 生产检测：两相机并行；ROI 和 VLM 通过受控并发避免压垮单图 VLM 实例。
PRODUCTION_IMAGE_PARALLELISM=2
PRODUCTION_ROI_PARALLELISM=3
PRODUCTION_VLM_PARALLELISM=3
PUBLIC_DETECT_SUCCESS_CODE=200
# 已发布检测场景的外部调用接口。留空仅适用于本地功能测试；生产环境请配置并通过 X-Scene-API-Key 请求头传入。
SCENE_API_KEY=
# 仅当 API 位于受信任的反向代理后方时保持 true，用于读取 X-Forwarded-For / X-Real-IP。
TRUSTED_PROXY_HEADERS=false
# SMB 生产图片交换。真实用户名和密码只写入本机 .env，禁止提交到 Git。
SMB_ENABLED=false
SMB_SERVER_ROOT=\\\\caxaprdfile.catl.com\\prd-file
SMB_USERNAME=
SMB_PASSWORD=
SMB_CONNECTION_TIMEOUT_SECONDS=15
VLM_SECRET_KEY=
# OpenAI 兼容 VLM 请求前自动等比缩放大图，避免视觉 Token 超出上限。
VLM_REQUEST_MAX_IMAGE_PIXELS=1003520
VLM_REQUEST_JPEG_QUALITY=90
# 历史 DINOv2 参考向量兼容参数。当前平台不再生成或调用本地 DINOv2 服务。
REFERENCE_EMBEDDING_MEMORY_CACHE_SIZE=512
REFERENCE_SIMILARITY_SCORING_MODE=ROBUST_TOP_K
REFERENCE_SIMILARITY_TOP_K=3
REFERENCE_SIMILARITY_TOP1_WEIGHT=0.65
AUTOMATION_WORKER_ENABLED=true
AUTOMATION_WORKER_POLL_SECONDS=2
TRAINING_GPU_RESERVE_MB=2048
TRAINING_GPU_POLL_SECONDS=15
# YOLO 训练产物、权重和曲线图的本地保存目录。
TRAINING_ARTIFACTS_ROOT=./data/training_runs
TRAINING_DEFAULT_WORKERS=2
# 优先从此目录读取 yolo11n.pt、yolo11n-seg.pt 等基础权重；离线服务器请提前放置。
VISION_MODEL_STORAGE_ROOT=./vision-models
# 固定相机下的小范围产品平移自动对齐。超过上限或置信度不足时保留原图检测并记录原因。
IMAGE_ALIGNMENT_ENABLED=true
IMAGE_ALIGNMENT_MAX_SHIFT_RATIO=0.05
IMAGE_ALIGNMENT_MIN_RESPONSE=0.08
IMAGE_ALIGNMENT_MAX_DIMENSION=1280
# 当配方某一 ROI 勾选“作为对齐基准”时，优先使用 ORB 特征点校正平移和轻微旋转。
IMAGE_ALIGNMENT_ANCHOR_SEARCH_MARGIN_RATIO=0.35
IMAGE_ALIGNMENT_ANCHOR_MIN_INLIERS=8
IMAGE_ALIGNMENT_ANCHOR_MIN_INLIER_RATIO=0.35
IMAGE_ALIGNMENT_ANCHOR_MAX_ROTATION_DEGREES=8
