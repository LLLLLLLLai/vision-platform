APP_NAME=Vision Platform
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=9010
DATABASE_URL=sqlite:///./data/vision_platform.db
EMBEDDING_STORAGE_ROOT=./embeddings
# Harness 风格的运行档案：模型和能力按插件组合；无需修改检测主流程即可替换服务。
HARNESS_PROFILE=production
HARNESS_CONFIG_PATH=config/harness.json
# 需要暂时禁用某个插件时以英文逗号分隔，例如：sam2,qwen3_vl
HARNESS_DISABLED_PLUGINS=
GROUNDING_SERVICE_URL=http://127.0.0.1:9021
DINOV2_SERVICE_URL=http://127.0.0.1:9022
DINO_MODEL_PATH=./vision-models/dinov2-base
DINO_DEVICE=auto
QWEN_VL_SERVICE_URL=http://127.0.0.1:9023
QWEN_VL_MODEL_PATH=./vision-models/qwen3-vl-4b-instruct
QWEN_VL_MODEL_ID=Qwen/Qwen3-VL-4B-Instruct
QWEN_VL_DOWNLOAD_SOURCE=modelscope
QWEN_VL_DEVICE=auto
QWEN_VL_QUANTIZATION=4bit
QWEN_VL_LOAD_ON_STARTUP=true
QWEN_VL_LOCAL_FILES_ONLY=true
QWEN_VL_MAX_NEW_TOKENS=1024
QWEN_VL_MAX_IMAGE_PIXELS=1003520
PADDLEOCR_SERVICE_URL=http://127.0.0.1:9024
# OCR service model settings. The local default is PP-OCRv5 mobile.
OCR_HOST=0.0.0.0
OCR_PORT=9024
OCR_DEVICE=cpu
OCR_CPU_THREADS=6
OCR_MIN_LINE_CONFIDENCE=0.40
OCR_USE_TEXTLINE_ORIENTATION=false
OCR_ENABLE_MKLDNN=true
OCR_VERSION=PP-OCRv5
OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
OCR_RECOGNITION_MODEL=PP-OCRv5_mobile_rec
# Red Hat 8.3 server example for PP-OCRv6 medium:
# OCR_VERSION=PP-OCRv6
# OCR_DETECTION_MODEL=PP-OCRv6_medium_det
# OCR_RECOGNITION_MODEL=PP-OCRv6_medium_rec
SAM2_SERVICE_URL=http://127.0.0.1:9025
SAM2_MODEL_PATH=./vision-models/sam2.1-hiera-small/sam2.1_hiera_small.pt
SAM2_MODEL_CONFIG=configs/sam2.1/sam2.1_hiera_s.yaml
SAM2_DEVICE=cpu
ALGORITHM_TIMEOUT_SECONDS=15
# 生产检测：两相机并行；ROI 和 VLM 通过受控并发避免压垮单图 VLM 实例。
PRODUCTION_IMAGE_PARALLELISM=2
PRODUCTION_ROI_PARALLELISM=3
PRODUCTION_VLM_PARALLELISM=3
PUBLIC_DETECT_SUCCESS_CODE=200
# 已发布检测场景的外部调用接口。留空仅适用于本地功能测试；生产环境请配置并通过 X-Scene-API-Key 请求头传入。
SCENE_API_KEY=
# 仅当 API 位于受信任的反向代理后方时保持 true，用于读取 X-Forwarded-For / X-Real-IP。
TRUSTED_PROXY_HEADERS=false
# SMB 生产图片交换。真实用户名和密码只写入本机 .env，禁止提交到 Git。
SMB_ENABLED=false
SMB_SERVER_ROOT=\\\\caxaprdfile.catl.com\\prd-file
SMB_USERNAME=
SMB_PASSWORD=
SMB_CONNECTION_TIMEOUT_SECONDS=15
# 候选基准自动采集已停用；历史候选数据保留但不再新增。
REFERENCE_CANDIDATE_COLLECTION_ENABLED=false
VLM_SECRET_KEY=
# OpenAI 兼容 VLM 请求前自动等比缩放大图，避免视觉 Token 超出 vLLM 上下文。
# 约 100 万像素适配 max_model_len=4096 的 Qwen3-VL 测试部署；高上下文模型可按实际能力调大。
VLM_REQUEST_MAX_IMAGE_PIXELS=1003520
VLM_REQUEST_JPEG_QUALITY=90
AUTOMATION_WORKER_ENABLED=true
AUTOMATION_WORKER_POLL_SECONDS=2
TRAINING_GPU_RESERVE_MB=2048
TRAINING_GPU_POLL_SECONDS=15
# YOLO 训练产物、权重和曲线图的本地保存目录。
TRAINING_ARTIFACTS_ROOT=./data/training_runs
TRAINING_DEFAULT_WORKERS=2
# 优先从此目录读取 yolo11n.pt、yolo11n-seg.pt 等基础权重；离线服务器请提前放置。
VISION_MODEL_STORAGE_ROOT=./vision-models
REFERENCE_CANDIDATE_VLM_CONFIDENCE_THRESHOLD=0.90
REFERENCE_CANDIDATE_LIMIT_PER_ROI=20
REFERENCE_CANDIDATE_HASH_DISTANCE=4
REFERENCE_APPROVED_LIMIT_PER_GROUP=10
REFERENCE_DUPLICATE_SIMILARITY_THRESHOLD=0.995
REFERENCE_DIVERSITY_IMPROVEMENT_MARGIN=0.005
REFERENCE_EMBEDDING_MEMORY_CACHE_SIZE=512
REFERENCE_SIMILARITY_SCORING_MODE=ROBUST_TOP_K
REFERENCE_SIMILARITY_TOP_K=3
REFERENCE_SIMILARITY_TOP1_WEIGHT=0.65
# 固定相机下的小范围产品平移自动对齐。超过上限或置信度不足时保留原图检测并记录原因。
IMAGE_ALIGNMENT_ENABLED=true
IMAGE_ALIGNMENT_MAX_SHIFT_RATIO=0.05
IMAGE_ALIGNMENT_MIN_RESPONSE=0.08
IMAGE_ALIGNMENT_MAX_DIMENSION=1280
# 当配方某一 ROI 勾选“作为对齐基准”时，优先使用 ORB 特征点校正平移和轻微旋转。
IMAGE_ALIGNMENT_ANCHOR_SEARCH_MARGIN_RATIO=0.35
IMAGE_ALIGNMENT_ANCHOR_MIN_INLIERS=8
IMAGE_ALIGNMENT_ANCHOR_MIN_INLIER_RATIO=0.35
IMAGE_ALIGNMENT_ANCHOR_MAX_ROTATION_DEGREES=8
